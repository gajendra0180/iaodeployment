rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backend-only access - all collections require admin SDK
    // These rules block direct client access
    // The backend uses Admin SDK which bypasses these rules

    match /{document=**} {
      // Default deny all client access
      // Backend uses Admin SDK (service account) which bypasses these rules
      allow read, write: if false;
    }
  }
}
