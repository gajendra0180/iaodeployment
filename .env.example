# Backend Server Configuration
NODE_ENV=development
PORT=3000

# Thirdweb x402 V2 Payment Processing
THIRDWEB_SECRET_KEY=sk_...
THIRDWEB_SERVER_WALLET_ADDRESS=0x...

# Google Cloud Platform Configuration
# Set your GCP project ID
GCP_PROJECT_ID=your-gcp-project-id

# For Cloud Run deployment, credentials are automatically provided
# For local development, use one of these options:
# Option 1: Set path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option 2: Set credentials as JSON string (for Vercel/Cloud Run secrets)
# GCP_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# Backend URL (for self-referencing API calls in agent operations)
# For local development: http://localhost:3000
# For production: https://your-backend-domain.vercel.app (or set in Vercel dashboard)
BACKEND_URL=http://localhost:3000


# Builder JWT Authentication
BUILDER_SECRET_PHRASE=your-shared-secret-phrase

# LLM Provider API Keys (for Agent Chat System)
# Claude (Anthropic) - Recommended for agent tool calling
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# GPT (OpenAI) - For alternative LLM provider
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gemini (Google) - For alternative LLM provider
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=...

# Company Wallet for Agent Payments (Phase 3)
# Private key used by agents to pay for API calls on behalf of users
COMPANY_WALLET_PRIVATE_KEY=0x...
